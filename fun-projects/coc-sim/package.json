{
  "name": "coc-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Realistic Clash of Clans TH8 war simulator: attack/base analysis and optimizers",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "data": "node tools/extract-th8.ts",
    "sim": "node src/cli.ts",
    "study": "node src/cli.ts study",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "web": "node tools/build-web.ts",
    "smoke": "node tools/smoke.ts"
  },
  "devDependencies": {
    "clash-of-clans-data": "0.19.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "@types/node": "22.18.6"
  }
}
